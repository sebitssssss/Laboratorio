using System;

namespace ConsoleApp1
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int[,] hotel = new int[2, 6];
            int total = 0;

            for (int piso = 0; piso < 2; piso++)
            {
                for (int depto = 0; depto < 6; depto++)
                {
                    Console.Write($"Ingrese la cantidad de habitantes en el piso {piso + 1}, departamento {depto + 1}: ");
                    hotel[piso, depto] = Convert.ToInt16(Console.ReadLine());
                    total += hotel[piso, depto];
                }

            }

            Console.WriteLine($"El total de habitantes en el hotel es de: {total}");

            for (int piso = 0; piso < 2; piso++)
            {
                int prom = 0;
                for (int depto = 0; depto < 6; depto++)
                {
                    prom += hotel[piso, depto];
                }

                Console.WriteLine($"El promedio del piso {piso + 1} es: {prom / 6} ");

            }
        }
    }
}
