using System.ComponentModel.DataAnnotations;

namespace ConsoleApp1
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int[,] matriz = new int[2, 3];

            int rejunte = 0;


            for (int fila = 0; fila < 2; fila++)
            {
                for (int columna = 0; columna < 3; columna++)
                {
                    Console.Write("Ingrese un número para [" + fila + "," + columna + "]: ");
                    matriz[fila, columna] = Convert.ToInt16(Console.ReadLine());
                    if (fila == 0)
                    {
                        matriz[fila, columna] = matriz[fila, columna] * 4;
                    }
                    else if (columna == 2)
                    {
                        matriz[fila, columna] = matriz[fila, columna] * 3;
                    }

                    rejunte += matriz[fila, columna];


                }
            }

            int min = matriz[0, 0];

            Console.WriteLine("\nMatriz:");

            for (int fila = 0; fila < 2; fila++)
            {
                for (int columna = 0; columna < 3; columna++)
                {
                    Console.Write(matriz[fila, columna] + "\t");

                    if (matriz[fila, columna] < min)
                    {
                        min = matriz[fila, columna];
                    }
                }
                Console.WriteLine("\n");
            } 
            Console.WriteLine("\n La sumatoria de todas las matrices es "+ rejunte);
            Console.WriteLine("El valor mas bajo fue: " + min);

        }
    }
}

